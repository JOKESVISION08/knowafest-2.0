rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles (those who sign in)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Saved event bookmarks
    match /savedEvents/{savedEventId} {
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    // Every month event data district-wise
    match /events_by_month_district/{docId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // Individual events collection
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }
  }
}
